# Supabase — leave blank to browse the demo without auth.
# Create a free project yourself if you want sign-in. This repo does not provision one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used to set a teacher role at signup.
# Without it, new accounts stay students (the safe default).
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI-compatible LLM. Leave blank and the generation routes return 503 plus a demo payload.
# OPENAI_API_KEY is the usual name. LLM_API_KEY is an alias if you prefer it.
OPENAI_API_KEY=
LLM_API_KEY=

# Optional. Point this at any OpenAI-compatible Chat Completions base URL.
# Example: https://api.openai.com/v1
LLM_BASE_URL=
OPENAI_BASE_URL=

# Chat model id for that endpoint. Change this when you pick a provider.
LLM_MODEL=gpt-4o-mini
