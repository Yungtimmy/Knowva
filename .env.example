# Supabase — leave blank to browse the demo without auth.
# Create a free project yourself if you want sign-in. This repo does not provision one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New publishable key (sb_publishable_...). Used when the anon key above is blank.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. The app does not assign a lecturer role.
# New accounts stay students.
# Prefer the new secret key (sb_secret_...). The legacy service-role JWT still works.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq. Leave blank and tutor chat, materials, and test generation return 503 plus a demo payload.
# Server only. Never prefix with NEXT_PUBLIC_. Never commit a real key.
# When this is set, the server calls https://api.groq.com/openai/v1 unless LLM_BASE_URL is set.
GROQ_API_KEY=

# Optional OpenAI-compatible fallback used only when GROQ_API_KEY is blank.
OPENAI_API_KEY=
LLM_API_KEY=

# Optional. Point this at any OpenAI-compatible Chat Completions base URL.
# Groq default when GROQ_API_KEY is set: https://api.groq.com/openai/v1
LLM_BASE_URL=
OPENAI_BASE_URL=

# Chat model id. Default is openai/gpt-oss-20b when GROQ_API_KEY is set, otherwise gpt-4o-mini.
LLM_MODEL=

# Optional vision model for images attached in tutor chat.
# Groq default is qwen/qwen3.8-27b. Llama 4 Scout was shut down on 17 July 2026.
# No new key. Uses GROQ_API_KEY (or the OpenAI-compatible fallback).
GROQ_VISION_MODEL=
